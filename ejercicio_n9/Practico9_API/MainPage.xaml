<?xml version="1.0" encoding="utf-8" ?>
<TabbedPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Practico9_API.MainPage"
             Title="Práctico 9 - API REST">

    <!-- Ejercicio 1: Lista de Posts -->
    <ContentPage Title="Posts">
        <ScrollView>
            <StackLayout Padding="10">
                <Label Text="Ejercicio 1: Lista de Posts" 
                       FontSize="18" 
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>
                <Button Text="Cargar Posts" 
                        Clicked="OnCargarPostsClicked"
                        Margin="0,10"/>
                <CollectionView x:Name="listaPosts">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="10" Margin="5" CornerRadius="5">
                                <StackLayout>
                                    <Label Text="{Binding Title}" 
                                           FontAttributes="Bold" 
                                           FontSize="14"/>
                                    <Label Text="{Binding Body}" 
                                           FontSize="12" 
                                           TextColor="Gray"/>
                                </StackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>
        </ScrollView>
    </ContentPage>

    <!-- Ejercicio 2: Usuarios con Imágenes -->
    <ContentPage Title="Usuarios">
        <ScrollView>
            <StackLayout Padding="10">
                <Label Text="Ejercicio 2: Usuarios con Imágenes" 
                       FontSize="18" 
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>
                <Button Text="Cargar Usuarios" 
                        Clicked="OnCargarUsuariosClicked"
                        Margin="0,10"/>
                <CollectionView x:Name="listaUsuarios">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="10" Margin="5" CornerRadius="5">
                                <Grid ColumnDefinitions="60, *">
                                    <Image Source="{Binding Avatar}"
                                           WidthRequest="50" 
                                           HeightRequest="50"
                                           Aspect="AspectFill"/>
                                    <StackLayout Grid.Column="1" 
                                                 VerticalOptions="Center"
                                                 Padding="10,0,0,0">
                                        <Label Text="{Binding Nombre}" 
                                               FontAttributes="Bold"/>
                                        <Label Text="{Binding Apellido}" 
                                               FontSize="12"/>
                                        <Label Text="{Binding Email}" 
                                               FontSize="11" 
                                               TextColor="Gray"/>
                                    </StackLayout>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>
        </ScrollView>
    </ContentPage>

    <!-- Ejercicio 3: Buscar Post por ID -->
    <ContentPage Title="Buscar">
        <ScrollView>
            <StackLayout Padding="10">
                <Label Text="Ejercicio 3: Buscar Post por ID" 
                       FontSize="18" 
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>
                <Grid ColumnDefinitions="*, Auto" Padding="10" Margin="0,10">
                    <Entry x:Name="txtId" 
                           Placeholder="ID del post (1-100)" 
                           Keyboard="Numeric"/>
                    <Button Text="Buscar" 
                            Clicked="OnBuscarClicked" 
                            Grid.Column="1"/>
                </Grid>
                <StackLayout x:Name="resultado" 
                            Padding="10" 
                            IsVisible="False">
                    <Frame Padding="15" CornerRadius="5">
                        <StackLayout>
                            <Label Text="Resultado:" 
                                   FontAttributes="Bold" 
                                   FontSize="14"/>
                            <Label x:Name="lblTitulo" 
                                   FontAttributes="Bold" 
                                   FontSize="16"/>
                            <Label x:Name="lblCuerpo" 
                                   FontSize="14" 
                                   TextColor="Gray"/>
                        </StackLayout>
                    </Frame>
                </StackLayout>
            </StackLayout>
        </ScrollView>
    </ContentPage>

    <!-- Ejercicio 4: Manejo de Errores -->
    <ContentPage Title="Errores">
        <ScrollView>
            <StackLayout Padding="10">
                <Label Text="Ejercicio 4: Manejo de Errores" 
                       FontSize="18" 
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>
                <Label Text="Prueba desconectando internet y presionando cargar" 
                       FontSize="12" 
                       TextColor="Gray"
                       HorizontalOptions="Center"
                       Margin="0,5"/>
                <Button Text="Cargar Posts (con manejo de errores)" 
                        Clicked="OnCargarConErroresClicked"
                        Margin="0,10"/>
                <CollectionView x:Name="listaPostsErrores">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="10" Margin="5" CornerRadius="5">
                                <StackLayout>
                                    <Label Text="{Binding Title}" 
                                           FontAttributes="Bold" 
                                           FontSize="14"/>
                                    <Label Text="{Binding Body}" 
                                           FontSize="12" 
                                           TextColor="Gray"/>
                                </StackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>
        </ScrollView>
    </ContentPage>

</TabbedPage>
