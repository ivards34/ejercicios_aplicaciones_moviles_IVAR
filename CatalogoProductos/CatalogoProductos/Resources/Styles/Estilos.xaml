<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colores.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <!-- Estilos de página -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor"

Value="{AppThemeBinding Light={StaticResource FondoClaro},
Dark={StaticResource FondoOscuro}}"/>
    </Style>
    <!-- Estilos de texto -->
    <Style x:Key="H1" TargetType="Label">
        <Setter Property="FontSize" Value="{OnIdiom Phone=28, Tablet=36,
Desktop=44}"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor"

Value="{AppThemeBinding Light={StaticResource TextoClaro},
Dark={StaticResource TextoOscuro}}"/>
    </Style>
    <Style x:Key="H2" TargetType="Label">
        <Setter Property="FontSize" Value="{OnIdiom Phone=22, Tablet=28,
Desktop=34}"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor"

Value="{AppThemeBinding Light={StaticResource TextoClaro},
Dark={StaticResource TextoOscuro}}"/>
    </Style>
    <Style x:Key="Body" TargetType="Label">
        <Setter Property="FontSize" Value="{OnIdiom Phone=14, Tablet=16,
Desktop=18}"/>
        <Setter Property="TextColor"

Value="{AppThemeBinding Light={StaticResource TextoClaro},
Dark={StaticResource TextoOscuro}}"/>
    </Style>
    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontSize" Value="{OnIdiom Phone=12, Tablet=14,
Desktop=16}"/>
        <Setter Property="TextColor"

Value="{AppThemeBinding Light={StaticResource
TextoSecundarioClaro},
Dark={StaticResource
TextoSecundarioOscuro}}"/>
    </Style>
    <!-- Estilos de botones -->
    <Style x:Key="BtnPrimario" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource
Primario}"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="HeightRequest" Value="50"/>
    </Style>
    <Style x:Key="BtnSecundario" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{StaticResource Primario}"/>
        <Setter Property="BorderColor" Value="{StaticResource Primario}"/>
        <Setter Property="BorderWidth" Value="2"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="CornerRadius" Value="12"/>
<Setter Property="HeightRequest" Value="50"/>
</Style>
<!-- Estilos de tarjetas -->
<Style x:Key="Card" TargetType="Border">
<Setter Property="Background"

Value="{AppThemeBinding Light={StaticResource
SuperficieClaro},
Dark={StaticResource
SuperficieOscuro}}"/>
<Setter Property="StrokeShape" Value="RoundRectangle 16"/>
<Setter Property="Padding" Value="15"/>
<Setter Property="Margin" Value="10,5"/>
</Style>
<!-- Estilos de inputs -->
<Style x:Key="Input" TargetType="Entry">
<Setter Property="FontSize" Value="16"/>
<Setter Property="PlaceholderColor"

Value="{AppThemeBinding Light={StaticResource
TextoSecundarioClaro},
Dark={StaticResource
TextoSecundarioOscuro}}"/>
<Setter Property="TextColor"

Value="{AppThemeBinding Light={StaticResource TextoClaro},
Dark={StaticResource TextoOscuro}}"/>
<Setter Property="HeightRequest" Value="50"/>

</Style>
</ResourceDictionary>