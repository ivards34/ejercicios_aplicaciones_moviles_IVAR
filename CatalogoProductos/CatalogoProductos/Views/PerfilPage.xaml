<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
x:Class="CatalogoProductos.Views.PerfilPage"
Title="Perfil">

    <ScrollView>
        <StackLayout Spacing="0">

            <!-- Header con foto de perfil -->

            <Grid BackgroundColor="{StaticResource Primario}"
                Padding="20"
                HeightRequest="200">

                <StackLayout VerticalOptions="Center" Spacing="10">
                    <Border WidthRequest="100"
                        HeightRequest="100"
                        StrokeShape="RoundRectangle 50"
                        Padding="0"
                        HorizontalOptions="Center"
                        Stroke="White"
                        StrokeThickness="2">

                        <Image Source="perfil.png" Aspect="AspectFill"/>
                    </Border>
                    <Label Text="Juan Pérez"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalOptions="Center"/>
                    <Label Text="juan@email.com"
                        FontSize="16"
                        TextColor="White"
                        HorizontalOptions="Center"/>

                </StackLayout>
            </Grid>

            <!-- Estadísticas -->

            <Grid Padding="20" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackLayout Grid.Column="0" Spacing="5">
                    <Label Text="25"
                        FontSize="24"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"/>

                    <Label Text="Compras"
                        Style="{StaticResource Caption}"
                        HorizontalOptions="Center"/>

                </StackLayout>
                <StackLayout Grid.Column="1" Spacing="5">
                    <Label Text="5"
                        FontSize="24"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"/>

                    <Label Text="Favoritos"
                        Style="{StaticResource Caption}"
                        HorizontalOptions="Center"/>

                </StackLayout>
                <StackLayout Grid.Column="2" Spacing="5">
                    <Label Text="12"
                        FontSize="24"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"/>

                    <Label Text="Reseñas"
                        Style="{StaticResource Caption}"
                        HorizontalOptions="Center"/>

                </StackLayout>
            </Grid>
            <!-- Opciones -->
            <StackLayout Padding="20" Spacing="10">
                <Border Style="{StaticResource Card}" Padding="0">
                    <StackLayout Spacing="0">
                        <Grid Padding="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label Text=" " FontSize="24"
                                VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                Text="Editar Perfil"
                                Style="{StaticResource Body}"
                                VerticalOptions="Center"
                                Margin="15,0,0,0"/>
                            <Label Grid.Column="2"
                                Text="›"
                                FontSize="24"
                                VerticalOptions="Center"/>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnEditarPerfilTapped"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView HeightRequest="1"

                            Color="{AppThemeBinding Light=LightGray, Dark=Gray}"

                            Margin="15,0"/>
                        <Grid Padding="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label Text=" " FontSize="24"
                                VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                Text="Mis Pedidos"
                                Style="{StaticResource Body}"
                                VerticalOptions="Center"
                                Margin="15,0,0,0"/>
                            <Label Grid.Column="2"
                                Text="›"
                                FontSize="24"
                                VerticalOptions="Center"/>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnMisPedidosTapped"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView HeightRequest="1"

                            Color="{AppThemeBinding Light=LightGray, Dark=Gray}"

                            Margin="15,0"/>
                        <Grid Padding="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label Text=" " FontSize="24"
                                VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                Text="Configuración"
                                Style="{StaticResource Body}"
                                VerticalOptions="Center"
                                Margin="15,0,0,0"/>
                            <Label Grid.Column="2"
                                Text="›"
                                FontSize="24"
                                VerticalOptions="Center"/>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnConfiguracionTapped"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                    </StackLayout>
                </Border>

                <!-- Botón Cerrar Sesión -->
                <Button Text="Cerrar Sesión"
                    Style="{StaticResource BtnSecundario}"
                    TextColor="{StaticResource Error}"
                    BorderColor="{StaticResource Error}"
                    Clicked="OnCerrarSesionClicked"
                    Margin="0,20,0,0"/>

            </StackLayout>
        </StackLayout>
    </ScrollView>
</ContentPage>