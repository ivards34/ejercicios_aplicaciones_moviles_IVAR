<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
x:Class="CatalogoProductos.Views.ProductosPage"
Title="Productos">
    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Barra de búsqueda -->
        <Border Grid.Row="0"
            Padding="0"
            Margin="15,10"
            StrokeShape="RoundRectangle 12"
            Background="{AppThemeBinding Light={StaticResource SuperficieClaro}, Dark={StaticResource SuperficieOscuro}}">
            <SearchBar x:Name="searchBar"
                Placeholder="Buscar productos..."
                TextChanged="OnSearchTextChanged"/>

        </Border>
        <!-- Lista de productos -->
        <RefreshView Grid.Row="1"
            x:Name="refreshView"
            Refreshing="OnRefreshing">

            <CollectionView x:Name="collectionViewProductos"
                SelectionMode="Single"
                SelectionChanged="OnProductoSelected"
                Margin="15,0">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"

                        Span="{OnIdiom Phone=2, Tablet=3, Desktop=4}"

                        VerticalItemSpacing="15"
                        HorizontalItemSpacing="15"/>

                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="10">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="150"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Image Source="{Binding Imagen}"
                                    Aspect="AspectFill"
                                    Grid.Row="0"/>
                                <Label Text="{Binding Nombre}"
                                    Grid.Row="1"
                                    Style="{StaticResource Body}"
                                    FontAttributes="Bold"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="2"/>
                                <Label Text="{Binding Precio, StringFormat='${0:F2}'}"

                                    Grid.Row="2"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource Exito}"/>

                                <StackLayout Grid.Row="3"
                                    Orientation="Horizontal" Spacing="5">
                                    <Label Text=" " FontSize="14"/>
                                    <Label Text="{Binding Calificacion}"
                                        Style="{StaticResource Caption}"/>
                                    <Label Text="|" Style="{StaticResource Caption}"/>
                                    <Label Text="{Binding Stock, StringFormat='Stock: {0}'}"

                                        Style="{StaticResource Caption}"/>
                                </StackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <StackLayout VerticalOptions="Center" Padding="50">
                        <Label Text=" " FontSize="64"
                            HorizontalOptions="Center"/>
                        <Label Text="No se encontraron productos"
                            Style="{StaticResource H2}"
                            HorizontalOptions="Center"/>
                        <Label Text="Intenta con otra búsqueda"
                            Style="{StaticResource Caption}"
                            HorizontalOptions="Center"/>

                    </StackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>