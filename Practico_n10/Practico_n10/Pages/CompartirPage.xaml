<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Practico_n10.Pages.CompartirPage"
             Title="Compartir">
    <StackLayout Padding="20" Spacing="15" VerticalOptions="Center">
        <Label Text="📤 Compartir" FontSize="24" FontAttributes="Bold"
               HorizontalOptions="Center" />
        <Entry x:Name="txtMensaje" Placeholder="Escribí un mensaje para compartir..." />
        <Button Text="Compartir" Clicked="OnCompartirClicked"
                BackgroundColor="#512BD4" TextColor="White" />
    </StackLayout>
</ContentPage>
